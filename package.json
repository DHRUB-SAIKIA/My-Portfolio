{
  "name": "smooth-scroll-animation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build && mkdir -p dist/public && cp -r dist/images dist/public/ 2>/dev/null || true && cp -r dist/frames dist/public/ 2>/dev/null || true",
