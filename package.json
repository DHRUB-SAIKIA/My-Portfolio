    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "lenis": "^1.1.9"
  }
}
